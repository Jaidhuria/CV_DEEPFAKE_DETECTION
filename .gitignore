# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environments
.venv/
.venv-win/
venv/
env/

# Local datasets
data/

# Model checkpoints (ignore intermediate weights, track verified best_model.pth)
checkpoints/*
!checkpoints/best_model.pth
*.pt
*.onnx

# Training logs and visual verification curves (committed as proof of training)
logs/*
!logs/training_log.csv
!logs/training_curves.png
!logs/confusion_matrix.png

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local secrets and environment configuration
.env
.env.*
!.env.example